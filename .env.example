# Required. There is intentionally no automatic fallback.
# Use "demo" for the in-memory prototype or "supabase" after stage 2 is implemented.
VITE_DATA_MODE=demo

# Optional. Demo failure/loading controls are hidden unless explicitly enabled.
VITE_ENABLE_DEMO_TOOLS=false

# Stage 2 browser-safe values. Required when VITE_DATA_MODE=supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Never place a Supabase secret/service-role key or Turnstile secret in a VITE_ variable.
# Server-only examples live in supabase/functions/.env.example.
