# Local Edge Function configuration. Copy to supabase/functions/.env; never commit the real file.
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
TURNSTILE_ALLOWED_HOSTNAMES=127.0.0.1,localhost
TURNSTILE_SECRET_KEY=replace-with-server-side-turnstile-secret
RATE_LIMIT_HASH_SECRET=replace-with-a-long-random-server-side-value

# SUPABASE_URL and SUPABASE_SECRET_KEYS are injected by Supabase locally and in hosted functions.
